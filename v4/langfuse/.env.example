# LangFuse 本地部署配置
# 复制此文件为 .env 并根据需要修改

# LangFuse 服务器配置
LANGFUSE_URL=http://localhost:3001
LANGFUSE_PUBLIC_KEY=pk-lf-local
LANGFUSE_SECRET_KEY=sk-lf-local

# NextAuth 配置（用于 LangFuse Web UI 认证）
LANGFUSE_NEXTAUTH_SECRET=your-secret-key-change-in-production-please
LANGFUSE_SALT=your-salt-change-in-production-please

# 数据库配置（docker-compose 默认配置）
DATABASE_URL=postgresql://langfuse:password@localhost:5432/langfuse
