{
  "name": "ai-company",
  "version": "1.0.0",
  "description": "AI Company - 让 AI 替你完成所有工作",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "ai-company": "./dist/interfaces/cli/index.js"
  },
  "scripts": {
    "init": "node scripts/init.js",
    "tell": "node scripts/tell.js",
    "status": "node scripts/status.js",
    "build": "tsc && npm run build:copy-assets && npm run build:bin",
    "build:copy-assets": "mkdir -p dist/infrastructure/database/seeds && cp src/infrastructure/database/seeds/*.sql dist/infrastructure/database/seeds/ || true",
    "build:bin": "echo '#!/bin/sh' > dist/ai-company && echo 'node \"$(dirname \"$0\")/interfaces/cli/index.js\" \"$@\"' >> dist/ai-company && chmod +x dist/ai-company",
    "dev": "tsc --watch",
    "start": "node dist/interfaces/cli/index.js",
    "server": "tsx src/server.ts",
    "server:watch": "tsx watch src/server.ts",
    "web": "cd src/web && vite",
    "web:build": "cd src/web && vite build",
    "web:start": "cd src/web && vite preview",
    "dev:all": "concurrently \"npm run server:watch\" \"npm run web\"",
    "restore:config": "tsx scripts/restore-config.ts",
    "test": "tsx tests/run-tests.ts",
    "test:watch": "tsx watch tests/run-tests.ts",
    "test:messages": "tsx tests/test-cli-message-flow.ts",
    "test:complete": "tsx tests/test-complete-flow.ts",
    "test:e2e": "tsx tests/test-end-to-end-flow.ts"
  },
  "keywords": [
    "ai",
    "automation",
    "agents",
    "orchestration"
  ],
  "author": "AI Company",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.1",
    "@bull-board/api": "^6.19.0",
    "@bull-board/express": "^6.19.0",
    "@fastify/cors": "^10.1.0",
    "@fastify/websocket": "^11.2.0",
    "@langchain/anthropic": "^1.3.19",
    "@langchain/core": "^1.1.27",
    "@types/better-sqlite3": "^7.6.13",
    "@types/convict": "^6.1.6",
    "@types/node-cron": "^3.0.11",
    "@types/pino": "^7.0.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^5.1.4",
    "axios": "^1.13.5",
    "better-sqlite3": "^12.6.2",
    "bull": "^4.16.5",
    "chalk": "^5.6.2",
    "chokidar": "^5.0.0",
    "commander": "^13.1.0",
    "convict": "^6.2.4",
    "dotenv": "^17.3.1",
    "drizzle-kit": "^0.31.9",
    "drizzle-orm": "^0.45.1",
    "eventemitter3": "^5.0.4",
    "fastify": "^5.7.4",
    "glob": "^13.0.6",
    "inquirer": "^12.11.1",
    "next": "^16.1.6",
    "node-cron": "^4.2.1",
    "node-pty": "^1.1.0",
    "node-telegram-bot-api": "^0.66.0",
    "ora": "^8.0.0",
    "pino": "^10.3.1",
    "playwright": "^1.58.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.0",
    "uuid": "^13.0.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.9",
    "@types/node": "^22.19.11",
    "@types/node-telegram-bot-api": "^0.64.8",
    "autoprefixer": "^10.4.24",
    "concurrently": "^9.2.1",
    "pino-pretty": "^13.1.3",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
