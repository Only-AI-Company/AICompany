# AI Company v2 - 环境变量配置
# 复制此文件为 .env 并填入实际的 API Key

# ============================================================================
# AI Provider API Keys
# 根据使用的 Provider 设置相应的 Key
# ============================================================================

# Anthropic (Claude)
# 获取：https://console.anthropic.com/settings/keys
# API: https://api.anthropic.com/v1/messages
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI (GPT-4, GPT-3.5)
# 获取：https://platform.openai.com/api-keys
# API: https://api.openai.com/v1/chat/completions
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 智谱 AI (GLM-4)
# 获取：https://open.bigmodel.cn/user/apikeys
# API: https://open.bigmodel.cn/api/paas/v4/chat/completions (OpenAI 兼容)
ZHIPU_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Kimi (月之暗面)
# 获取：https://platform.moonshot.cn/console/api-keys
# API: https://api.moonshot.cn/v1/chat/completions (OpenAI 兼容)
KIMI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 通义千问 (Qwen)
# 获取：https://dashscope.console.aliyun.com/apiKey
# API: https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions (OpenAI 兼容)
QWEN_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================================
# 其他配置
# ============================================================================

# 时区
TZ=Asia/Shanghai

# 日志级别 (debug, info, warn, error)
LOG_LEVEL=info
