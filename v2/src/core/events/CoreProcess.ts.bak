  /**
   * CFO 处理财务/分析任务
   */
  private async handleCFOTask(analysis: CEOAnalysisResult, event: UserInputEvent): Promise<void> {
    console.log(`[CoreProcess] 📊 CFO 处理财务/分析任务: ${analysis.userInput.substring(0, 50)}...`);

    try {
      // 使用 CFO 执行器
      const { getCFO } = await import('../cxo/index.js');
      const cfo = getCFO();

